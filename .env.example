# Supabase project credentials
# Find these in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Identity Services OAuth client (Web application).
# Google Cloud Console -> APIs & Services -> Credentials.
# Add http://localhost:5173 and the production URL under "Authorized JavaScript
# origins" -- this flow returns the token in-page, so no redirect URI is needed.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Bitrix24 REST webhook (server-side only -- NOT VITE_ prefixed, must never
# ship in the client bundle). Read by the refresh scripts, the Vite dev proxy,
# and netlify/functions/bitrix.mjs at runtime.
BITRIX_WEBHOOK_BASE=https://your-instance.bitrix24.com/rest/1/your-webhook-token

# Supabase service-role credentials for the batch refresh scripts
# (scripts/supabaseAdmin.mjs), run locally and by the GitHub Actions job in
# .github/workflows/refresh-names.yml.
#
# These are NOT part of the deployed app. The service-role key bypasses RLS, so
# never add it to the Netlify site's environment variables -- the browser bundle
# and the functions runtime have no use for it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
